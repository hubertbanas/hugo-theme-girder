{
  "name": "hugo-theme-girder",
  "version": "0.1.0",
  "description": "A boxed, corporate Hugo theme for company sites.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Hubert Banas",
  "repository": "github:hubertbanas/hugo-theme-girder",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "spell": "cspell --no-progress --gitignore .",
    "check": "npm run format:check && npm run lint && npm run lint:md && npm run spell",
    "check:build": "node scripts/check-build.mjs",
    "check:private": "node scripts/check-private-terms.mjs",
    "check:publish": "scripts/publish-check.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cspell": "10.5.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1"
  },
  "engines": {
    "node": ">=22"
  }
}
